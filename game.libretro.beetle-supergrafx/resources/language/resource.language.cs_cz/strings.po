msgctxt "Addon Summary"
msgid "NEC - PC Engine SuperGrafx (Beetle SuperGrafx)"
msgstr "NEC - PC Engine SuperGrafx (Beetle SuperGrafx)"

msgctxt "Addon Description"
msgid "Beetle SuperGrafx is a PC Engine emulator. It was ported from Mednafen PCE Fast to libretro."
msgstr "Beetle SuperGrafx je emulátor PC Engine. Byl portován z Mednafen PCE Fast do libretro."

msgctxt "#30001"
msgid "Color Palette"
msgstr "Barevná paleta"

msgctxt "#30002"
msgid "Aspect Ratio"
msgstr "Poměr stran"

