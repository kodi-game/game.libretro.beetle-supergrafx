msgstr "Režim zkratky Turbo"

msgctxt "#30016"
msgid "Alternate Turbo Hotkey"
msgstr "Alternativní zkratka Turbo"

msgctxt "#30017"
msgid "Turbo Delay"
msgstr "Prodleva Turbo"

msgctxt "#30018"
msgid "CD Image Cache (Restart Required)"
msgstr "Mezipaměť bitových kopií CD (vyžaduje restart)"

msgctxt "#30019"
msgid "CD BIOS (Restart Required)"
msgstr "BIOS CD (vyžaduje restart)"

msgctxt "#30020"
msgid "Detect Games Express CD (Restart Required)"
msgstr "Detekovat CD Games Express (vyžaduje restart)"

