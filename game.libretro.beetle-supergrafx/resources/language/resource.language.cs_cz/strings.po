msgid "CD Image Cache (Restart Required)"
msgstr "Vyrovnávací paměť obrazu CD (nutný restart)"

msgctxt "#30019"
msgid "CD BIOS (Restart Required)"
msgstr "CD BIOS (nutný restart)"

msgctxt "#30020"
msgid "Detect Games Express CD (Restart Required)"
msgstr "Detekovat Express CD Hry (Vyžadován Restart)"

